<?xml version="1.0" encoding="UTF-8"?>
<fonts>

    <fontset id="Default" unicode="true">
        <include content="Font_Default">
            <param name="font_bold">NotoSansKR-Bold.ttf</param>
            <param name="font_regular">NotoSansKR-Regular.ttf</param>
            <param name="font_light">NotoSansKR-Regular.ttf</param>
        </include>
    </fontset>

    <fontset id="Default (Unicode)" unicode="true">
        <include content="Font_Default">
            <param name="font_bold">NotoSansKR-Bold.ttf</param>
            <param name="font_regular">NotoSansKR-Regular.ttf</param>
            <param name="font_light">NotoSansKR-Regular.ttf</param>
            <param name="style_light">light</param>

            <param name="plot_linespacing_head">1.03</param>
            <param name="plot_linespacing_midi">1.45</param>
            <param name="plot_linespacing_main">1.13</param>
            <param name="plot_linespacing_mini">1.20</param>
            <param name="plot_linespacing_tiny">1.11</param>
        </include>
    </fontset>
    <!-- Optional personal fonts live outside the replaceable skin directory. -->
    <fontset id="Apple SD Gothic Neo" unicode="true">
        <include content="Font_Default">
            <param name="font_bold">special://home/media/Fonts/AppleSDGothicNeo-Bold.ttf</param>
            <param name="font_regular">special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</param>
            <param name="font_light">special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</param>
        </include>
    </fontset>
</fonts>

