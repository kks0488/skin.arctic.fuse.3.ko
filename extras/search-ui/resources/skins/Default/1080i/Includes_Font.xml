<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- WindowXML is loaded as a small standalone skin. Re-declare the
         typography used by HomeKoSearch so Korean compatibility jamo do not
         fall back to the Android placeholder glyph. The font remains in the
         user's private Kodi media/Fonts directory. -->
    <font>
        <name>font_huge_bold</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Bold.ttf</filename>
        <size>43</size>
    </font>
    <font>
        <name>font_head</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</filename>
        <size>38</size>
    </font>
    <font>
        <name>font_main_bold</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Bold.ttf</filename>
        <size>28</size>
    </font>
    <font>
        <name>font_main</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</filename>
        <size>28</size>
    </font>
    <font>
        <name>font_mini</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</filename>
        <size>24</size>
    </font>
    <font>
        <name>font_tiny</name>
        <filename>special://home/media/Fonts/AppleSDGothicNeo-Regular.ttf</filename>
