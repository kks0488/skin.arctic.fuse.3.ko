<?xml version='1.0' encoding='UTF-8'?>
<smartplaylist type="movies">
    <name>최근 추가 영화</name>
    <match>all</match>
    <rule field="lastplayed" operator="inthelast">
        <value>28 Days</value>
    </rule>
    <limit>20</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>